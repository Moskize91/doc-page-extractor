# Local development defaults.
#
# Copy this file to .env for machine-specific values. The package does not
# automatically read this file; scripts and development adapters load it when
# they need private OCR settings.

# DeepSeek OCR via OpenAI-compatible Vendor.
DPE_DEEPSEEK_OCR_BASE_URL=
DPE_DEEPSEEK_OCR_API_KEY=
DPE_DEEPSEEK_OCR_MODEL=deepseek-ocr
DPE_DEEPSEEK_OCR_TEMPERATURE=0.0
DPE_DEEPSEEK_OCR_TOP_P=0.7
DPE_DEEPSEEK_OCR_MAX_TOKENS=8000
DPE_DEEPSEEK_OCR_TIMEOUT_SECONDS=180

# DeepSeek OCR 2 via OpenAI-compatible Vendor.
DPE_DEEPSEEK_OCR2_BASE_URL=
DPE_DEEPSEEK_OCR2_API_KEY=
DPE_DEEPSEEK_OCR2_MODEL=
DPE_DEEPSEEK_OCR2_TEMPERATURE=0.0
DPE_DEEPSEEK_OCR2_TOP_P=0.7
DPE_DEEPSEEK_OCR2_MAX_TOKENS=8000
DPE_DEEPSEEK_OCR2_TIMEOUT_SECONDS=180

# Unlimited OCR cloud backend.
DPE_UNLIMITED_OCR_ACCESS_KEY=
DPE_UNLIMITED_OCR_SECRET_KEY=
DPE_UNLIMITED_OCR_BASE_URL=https://aip.baidubce.com
DPE_UNLIMITED_OCR_POLL_INTERVAL_SECONDS=2
DPE_UNLIMITED_OCR_TIMEOUT_SECONDS=180

# DeepSeek local Hugging Face backend. Used only when explicitly testing CUDA.
DPE_DEEPSEEK_LOCAL_MODEL_PATH=./models-cache
DPE_DEEPSEEK_LOCAL_ONLY=true
